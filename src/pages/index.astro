---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero";
import HomeAbout from "../components/home/HomeAbout";
import HomeActivities from "../components/home/HomeActivities";
import HomeVideo from "../components/home/HomeVideo";
import HomeNews from "../components/home/HomeNews";
import client from "../../tina/__generated__/client";
import { pageLocale, seoOf } from "../lib/pageLocale";
import { nodesOf, sortByDateDesc, sortByOrder, toActivityCard, toPostCard } from "../lib/viewModels";

const locale = pageLocale(Astro);
const { query, variables, data } = await client.queries.home({ relativePath: "index.json" });
const sectionProps = { query, variables, data, locale };

const activityResult = await client.queries.activityConnection({ first: 50 });
const activities = sortByOrder(nodesOf(activityResult.data.activityConnection))
  .filter((activity: any) => activity.showOnHome)
  .map((activity) => toActivityCard(activity, locale));

const postResult = await client.queries.postConnection({ first: 50 });
const posts = sortByDateDesc(nodesOf(postResult.data.postConnection)).map((post) => toPostCard(post, locale));
const seo = seoOf(data.home.seo, locale);
---

<BaseLayout title={seo.title} description={seo.description} image={data.home.hero?.image ?? undefined}>
  <HomeHero {...sectionProps} client:tina />
  <HomeAbout {...sectionProps} client:tina />
  <HomeActivities {...sectionProps} activities={activities} client:tina />
  <HomeVideo {...sectionProps} client:visible />
  <HomeNews {...sectionProps} posts={posts} client:tina />
</BaseLayout>
