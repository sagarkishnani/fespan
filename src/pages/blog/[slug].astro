---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostArticle from "../../components/blog/PostArticle";
import ShareBar from "../../components/blog/ShareBar";
import PostCard from "../../components/cards/PostCard";
import client from "../../../tina/__generated__/client";
import { pageLocale } from "../../lib/pageLocale";
import { nodesOf, sortByDateDesc, toPostCard } from "../../lib/viewModels";
import { tField } from "../../utils/i18n";
import { t } from "../../i18n/ui";

export async function getStaticPaths() {
  const result = await client.queries.postConnection({ first: 500 });
  return nodesOf(result.data.postConnection).map((post: any) => ({ params: { slug: post._sys.filename } }));
}

const { slug } = Astro.params;
const locale = pageLocale(Astro);
const { query, variables, data } = await client.queries.post({ relativePath: `${slug}.mdx` });
const post = data.post;
const title = tField(post, "title", locale);

const allPosts = await client.queries.postConnection({ first: 500 });
const related = sortByDateDesc(nodesOf(allPosts.data.postConnection))
  .filter((candidate: any) => candidate._sys.filename !== slug)
  .slice(0, 3)
  .map((candidate) => toPostCard(candidate, locale));
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout title={`${title} — FESPAN`} description={tField(post, "excerpt", locale)} image={post.coverImage ?? undefined}>
  <PostArticle query={query} variables={variables} data={data} locale={locale} client:tina>
    <ShareBar url={canonical} title={title} locale={locale} client:visible />
  </PostArticle>
  {related.length > 0 && (
    <section class="container-xl pb-20 pt-24 lg:pb-[120px] lg:pt-[130px]">
      <h2 data-reveal class="mb-12 text-heading-lg">{t("blog.related", locale)}</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {related.map((card) => (
          <div data-reveal>
            <PostCard post={card} ctaLabel={t("common.readArticle", locale)} />
          </div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
