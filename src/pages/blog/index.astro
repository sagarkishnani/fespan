---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogTitle from "../../components/blog/BlogTitle";
import BlogBrowser from "../../components/blog/BlogBrowser";
import client from "../../../tina/__generated__/client";
import { pageLocale, seoOf } from "../../lib/pageLocale";
import { nodesOf, sortByDateDesc, toPostCard } from "../../lib/viewModels";
import { translateTerm } from "../../i18n/ui";
import { BLOG_CATEGORIES } from "../../../tina/collections/post";

const locale = pageLocale(Astro);
const { query, variables, data } = await client.queries.blogPage({ relativePath: "index.json" });
const postResult = await client.queries.postConnection({ first: 500 });
const posts = sortByDateDesc(nodesOf(postResult.data.postConnection)).map((post) => toPostCard(post, locale));
const usedCategories = new Set(posts.map((post) => post.categoryKey));
const categories = BLOG_CATEGORIES.filter((key) => usedCategories.has(key)).map((key) => ({ key, label: translateTerm(key, locale) }));
const seo = seoOf(data.blogPage.seo, locale);
---

<BaseLayout title={seo.title} description={seo.description} showCta>
  <section class="container-xl pb-16 pt-[104px] md:pb-20 md:pt-[136px] lg:pb-[120px] lg:pt-[180px]">
    <BlogBrowser posts={posts} categories={categories} locale={locale} client:load>
      <BlogTitle query={query} variables={variables} data={data} locale={locale} client:tina />
    </BlogBrowser>
  </section>
</BaseLayout>
