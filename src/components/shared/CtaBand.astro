---
import CtaBandReact from "./CtaBandReact";
import client from "../../../tina/__generated__/client";
import type { Locale } from "../../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const result = await client.queries.global({ relativePath: "index.json" });
---

<CtaBandReact query={result.query} variables={result.variables} data={result.data} locale={locale} client:tina />
