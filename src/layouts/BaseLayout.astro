---
import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";
import CtaBand from "../components/shared/CtaBand.astro";
import client from "../../tina/__generated__/client";
import { ClientRouter } from "astro:transitions";
import { getLocale, tField, localizedPath } from "../utils/i18n";
import { isLocale, LOCALES, DEFAULT_LOCALE } from "../i18n/config";
import { mediaUrl } from "../utils/mediaUrl";
import "../styles/global.css";
import CookieConsent from "../components/cookies/CookieConsent.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showCta?: boolean;
}

const { title, description, image, showCta = false } = Astro.props;

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);

let globalData: any = null;
try {
  const result = await client.queries.global({ relativePath: "index.json" });
  globalData = result.data?.global;
} catch {}

const seoTitle = title || tField(globalData?.seo, "title", locale) || "FESPAN";
const seoDescription =
  description || tField(globalData?.seo, "description", locale) || "Federación de Sociedades Panamericanas de Nutrición. Integramos a las sociedades de nutrición de las Américas para mejorar la salud de nuestras poblaciones.";
const siteOrigin = Astro.site || "https://fespan.org";
const ogImageSource = image || globalData?.seo?.ogImage || "";
const ogImage = ogImageSource ? new URL(mediaUrl(ogImageSource), siteOrigin).href : "";
const alternates = LOCALES.map((code) => ({
  code,
  href: new URL(localizedPath(Astro.url.pathname, code), siteOrigin).href,
}));
const injectHead = globalData?.codeInjection?.head || "";
const injectBodyEnd = globalData?.codeInjection?.bodyEnd || "";

const canonical = new URL(Astro.url.pathname, Astro.site || "https://fespan.org").href;

const orgSocials = (globalData?.footer?.social || [])
  .map((s: any) => s?.url)
  .filter(Boolean);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "FESPAN",
  url: Astro.site?.href || "https://fespan.org",
  description: seoDescription,
  email: "presidenta@fespan.org",
  ...(globalData?.nav?.logo ? { logo: new URL(globalData.nav.logo, Astro.site || "https://fespan.org").href } : {}),
  ...(orgSocials.length ? { sameAs: orgSocials } : {}),
};

let maintenance: any = null;
try {
  const result = await client.queries.maintenance({ relativePath: "index.json" });
  maintenance = result.data?.maintenance?.enabled ? result.data.maintenance : null;
} catch {}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.find((alt) => alt.code === DEFAULT_LOCALE)?.href} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" />
    <script is:inline>document.documentElement.classList.add("reveal-ready");</script>

    <ClientRouter />
    <Fragment set:html={injectHead} />
  </head>
  <body>
    {maintenance ? (
      <main class="flex min-h-screen items-center justify-center px-6 text-center">
        <div class="max-w-xl">
          <h1 class="text-heading-lg">{maintenance.title || "Estamos en mantenimiento"}</h1>
          <p class="mt-4 text-body-lg text-content-muted">
            {maintenance.message || "Volvemos en unos minutos."}
          </p>
          {maintenance.showContact && (
            <a class="btn-primary mt-8" href={maintenance.contactUrl || "/"}>
              {maintenance.contactText || "Contáctanos"}
            </a>
          )}
        </div>
      </main>
    ) : (
      <>
        <Header locale={locale} />
        <main>
          <slot />
        </main>
        {showCta && <CtaBand locale={locale} />}
        <Footer locale={locale} />
        <CookieConsent />
      </>
    )}
    <Fragment set:html={injectBodyEnd} />
    <script>
      import Lenis from "lenis";

      let lenis: any = null;

      function startLenis() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        lenis?.destroy();
        lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        const raf = (time: number) => {
          lenis?.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      startLenis();
      document.addEventListener("astro:after-swap", startLenis);

      const COUNT_DURATION_MS = 1800;

      function countUp(element: HTMLElement) {
        const target = Number(element.dataset.count || 0);
        const startedAt = performance.now();
        const step = (now: number) => {
          const progress = Math.min(1, (now - startedAt) / COUNT_DURATION_MS);
          const eased = 1 - Math.pow(1 - progress, 3);
          element.textContent = Math.round(target * eased).toLocaleString("en-US");
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }

      function reveal(element: Element) {
        element.classList.add("is-revealed");
        element.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp);
      }

      function observeReveals() {
        const pending = document.querySelectorAll("[data-reveal]:not(.is-revealed)");
        if (!("IntersectionObserver" in window)) {
          pending.forEach(reveal);
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              reveal(entry.target);
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        pending.forEach((element) => observer.observe(element));
      }

      document.addEventListener("astro:page-load", observeReveals);
    </script>
  </body>
</html>
